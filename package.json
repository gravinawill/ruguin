{
  "name": "@ruguin/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:apps": "turbo build --filter=./apps/*",
    "build:configs": "turbo build --filter=./configs/*",
    "build:packages": "turbo build --filter=./packages/*",
    "check": "turbo check:types && turbo check:lint && pnpm check:format && pnpm check:spelling",
    "check:format": "prettier --cache --check --ignore-path .gitignore --ignore-path .prettierignore .",
    "check:lint": "turbo run check:lint",
    "check:spelling": "cspell -c .cspell.json --no-progress --no-summary --no-must-find-files --unique",
    "check:types": "turbo run check:types",
    "clean": "turbo clean && rm -rf .claude-flow .swarm .superpowers .remember .gitnexus .turbo coverage node_modules dist build",
    "commit": "czg",
    "dev": "dotenvx run -f .env -- turbo run dev",
    "dev:apps": "dotenvx run -f .env -- turbo run dev --filter=./apps/*",
    "fix": "turbo fix:lint && pnpm fix:format",
    "fix:format": "prettier --cache --write --list-different --ignore-path .gitignore --ignore-path .prettierignore .",
    "fix:lint": "turbo run fix:lint",
    "infra:all:down": "docker compose -f infrastructure/local/docker-compose.yml -f infrastructure/local/docker-compose.tools.yml -f infrastructure/local/docker-compose.observability.yml down",
    "infra:all:up": "docker compose -f infrastructure/local/docker-compose.yml -f infrastructure/local/docker-compose.tools.yml -f infrastructure/local/docker-compose.observability.yml up -d",
    "infra:down": "docker compose -f infrastructure/local/docker-compose.yml down",
    "infra:load-test": "docker compose -f infrastructure/local/docker-compose.yml -f infrastructure/local/docker-compose.tools.yml run --rm k6 run /scripts/smoke.ts",
    "infra:load-test:core-server": "docker compose -f infrastructure/local/docker-compose.yml -f infrastructure/local/docker-compose.tools.yml run --rm k6 run /scripts/core-server-health.ts",
    "infra:logs": "docker compose -f infrastructure/local/docker-compose.yml logs -f",
    "infra:observability:down": "docker compose -f infrastructure/local/docker-compose.yml -f infrastructure/local/docker-compose.observability.yml down",
    "infra:observability:up": "docker compose -f infrastructure/local/docker-compose.yml -f infrastructure/local/docker-compose.observability.yml up -d",
    "infra:reset": "docker compose -f infrastructure/local/docker-compose.yml down -v",
    "infra:tools:down": "docker compose -f infrastructure/local/docker-compose.yml -f infrastructure/local/docker-compose.tools.yml down",
    "infra:tools:up": "docker compose -f infrastructure/local/docker-compose.yml -f infrastructure/local/docker-compose.tools.yml up -d",
    "infra:up": "docker compose -f infrastructure/local/docker-compose.yml up -d",
    "preinstall": "npx --yes only-allow pnpm",
    "postinstall": "pnpm run build",
    "prepare": "husky",
    "test": "turbo run test:all",
    "test:coverage": "turbo run test:cov",
    "test:watch": "vitest",
    "update:deps": "turbo run update:deps && ncu -u && pnpm install",
    "with-env": "dotenvx run -f .env --"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@cspell/dict-bash": "^4.2.3",
    "@cspell/dict-companies": "^3.2.12",
    "@cspell/dict-en-gb": "5.0.30",
    "@cspell/dict-es-es": "^3.0.8",
    "@cspell/dict-filetypes": "^3.0.18",
    "@cspell/dict-html": "^4.0.15",
    "@cspell/dict-lorem-ipsum": "^4.0.5",
    "@cspell/dict-node": "^5.0.9",
    "@cspell/dict-npm": "^5.2.43",
    "@cspell/dict-pt-br": "^2.4.2",
    "@cspell/dict-redis": "^1.0.7",
    "@cspell/dict-software-terms": "^5.2.4",
    "@cspell/dict-typescript": "^3.2.3",
    "@dotenvx/dotenvx": "^2.19.1",
    "@ruguin/eslint-config": "workspace:*",
    "@ruguin/prettier-config": "workspace:*",
    "@ruguin/typescript-config": "workspace:*",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "cspell": "^10.0.1",
    "czg": "^1.13.1",
    "danger": "^13.0.10",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "npm-check-updates": "23.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-prisma": "^5.0.0",
    "semantic-release": "25.0.8",
    "tsx": "^4.23.1",
    "turbo": "^2.10.8",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "26.5.0"
  }
}
