{
  "name": "@ruguin/core-server",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "prisma generate && nest build && node scripts/fix-esm-imports.mjs",
    "check:lint": "eslint . --max-warnings 0",
    "check:types": "tsc --noEmit --pretty",
    "clean": "rm -rf .claude-flow .swarm .superpowers .remember .gitnexus .turbo coverage node_modules dist build src/generated",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "dev": "nodemon --watch src --ext ts --exec \"pnpm run build && pnpm run start\"",
    "fix:lint": "eslint --fix .",
    "start": "node --import ./dist/tracing.js dist/main.js",
    "start:debug": "node --inspect --import ./dist/tracing.js dist/main.js",
    "start:dev": "nodemon --watch src --ext ts --exec \"pnpm run build && pnpm run start\"",
    "start:prod": "NODE_ENV=production node --import ./dist/tracing.js dist/main.js",
    "test": "vitest run --project unit",
    "test:all": "vitest run",
    "test:cov": "vitest run --project unit --coverage",
    "test:e2e": "vitest run --project e2e",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "update:deps": "ncu -u"
  },
  "dependencies": {
    "@fastify/basic-auth": "6.3.0",
    "@fastify/compress": "9.2.0",
    "@fastify/helmet": "13.1.1",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-fastify": "^12.1.0",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@ruguin/cache": "workspace:*",
    "@ruguin/ddd-kernel": "workspace:*",
    "@ruguin/env": "workspace:*",
    "@ruguin/utils": "workspace:*",
    "@scalar/nestjs-api-reference": "1.2.23",
    "nestjs-pino": "^5.2.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@ruguin/eslint-config": "workspace:*",
    "@ruguin/prettier-config": "workspace:*",
    "@ruguin/typescript-config": "workspace:*",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.47",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "typescript": "6.0.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.10"
  }
}
