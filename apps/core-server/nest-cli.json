{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": {
      "type": "swc",
      "options": {
        "ignore": ["**/*.spec.ts", "**/*.unit.ts", "**/*.e2e.ts", "**/*.int.ts"]
      }
    },
    "typeCheck": true
  }
}
