# syntax=docker/dockerfile:1
#
# Local development only — not what release-image.yml builds or publishes (that's ./Dockerfile).
# Single stage, full devDependencies, nodemon watch mode. Bind-mount the repo over /repo for live
# reload; without a mount this still works off the COPY below, just without picking up edits.
#
#   docker build -f apps/core-server/Dockerfile.dev -t ruguin/core-server:dev .
#   docker run --rm -it -p 3333:3333 -v "$(pwd)":/repo -w /repo/apps/core-server \
#     --network ruguin_default ruguin/core-server:dev
#
# The backing services (Postgres, Kafka, Valkey, LocalStack, ...) still come from
# infrastructure/local/docker-compose.yml — this image only runs the app itself.
FROM node:26.5.1-alpine
WORKDIR /repo

# node:26 dropped the bundled corepack binary; npm is still present, so it installs corepack itself.
RUN npm install -g corepack@0.35.0 --ignore-scripts && corepack enable

COPY . .
# No --ignore-scripts here, unlike the production Dockerfile: dev needs Prisma's schema-engine
# and the other native builds (@swc/core, esbuild) that `pnpm-workspace.yaml`'s
# onlyBuiltDependencies list allows, since `pnpm dev` runs the real build on every file change.
RUN pnpm install --frozen-lockfile

WORKDIR /repo/apps/core-server
EXPOSE 3333
CMD ["pnpm", "run", "dev"]
