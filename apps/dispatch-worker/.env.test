# Loaded by vitest.config.ts's loadEnv() for integration/e2e tests against the local docker
# stack (infrastructure/local/docker-compose.yml). No real secrets — LocalStack's SES emulator
# accepts any string as AWS credentials, and Kafka/cache values are just local service addresses.
KAFKA_BOOTSTRAP_BROKERS=localhost:9092
CACHE_PREFIX=ruguin:test
ENVIRONMENT=test

AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SES_FROM_ADDRESS=test@ruguin.local
