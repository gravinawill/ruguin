{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "ENVIRONMENT",
    "PORT",
    "DATABASE_URL",
    "LOGGER_DRIVER",
    "AWS_*",
    "CACHE_*",
    "DOCS_*",
    "JWT_*",
    "KAFKA_*",
    "LOG_*",
    "OTEL_*",
    "SES_*"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        "dist/**",
        "generated/**",
        "dist-seed/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "src/shared/infrastructure/database/prisma/generated/**"
      ]
    },
    "clean": {
      "dependsOn": ["^clean"]
    },
    "fix:lint": {
      "dependsOn": ["^fix:lint"]
    },
    "update:deps": {
      "dependsOn": ["^update:deps"]
    },
    "check:lint": {
      "dependsOn": ["^check:lint"]
    },
    "check:types": {
      "dependsOn": ["^check:types"]
    },
    "check:format": {
      "dependsOn": ["^check:format"]
    },
    "test:all": {
      "dependsOn": ["^test:all"]
    },
    "test:cov": {
      "dependsOn": ["^test:cov"]
    },
    "fix:format": {
      "dependsOn": ["^fix:format"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
